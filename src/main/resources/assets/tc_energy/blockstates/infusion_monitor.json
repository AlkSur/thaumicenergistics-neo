{
  "multipart": [
    { "when": { "facing": "north" }, "apply": { "model": "tc_energy:block/infusion_monitor_off", "y": 180 } },
    { "when": { "facing": "south" }, "apply": { "model": "tc_energy:block/infusion_monitor_off", "y": 0 } },
    { "when": { "facing": "east" }, "apply": { "model": "tc_energy:block/infusion_monitor_off", "y": 270 } },
    { "when": { "facing": "west" }, "apply": { "model": "tc_energy:block/infusion_monitor_off", "y": 90 } },
    { "when": { "facing": "north", "book": "true" }, "apply": { "model": "tc_energy:block/infusion_monitor_book", "y": 180 } },
    { "when": { "facing": "south", "book": "true" }, "apply": { "model": "tc_energy:block/infusion_monitor_book", "y": 0 } },
    { "when": { "facing": "east", "book": "true" }, "apply": { "model": "tc_energy:block/infusion_monitor_book", "y": 270 } },
    { "when": { "facing": "west", "book": "true" }, "apply": { "model": "tc_energy:block/infusion_monitor_book", "y": 90 } },
    { "when": { "facing": "north", "book": "true", "network": "true" }, "apply": { "model": "tc_energy:block/infusion_monitor_on", "y": 180 } },
    { "when": { "facing": "south", "book": "true", "network": "true" }, "apply": { "model": "tc_energy:block/infusion_monitor_on", "y": 0 } },
    { "when": { "facing": "east", "book": "true", "network": "true" }, "apply": { "model": "tc_energy:block/infusion_monitor_on", "y": 270 } },
    { "when": { "facing": "west", "book": "true", "network": "true" }, "apply": { "model": "tc_energy:block/infusion_monitor_on", "y": 90 } }
  ]
}
